diff --git a/src/include/custommem.h b/src/include/custommem.h
index 6571ef23a..8af19b88f 100644
--- a/src/include/custommem.h
+++ b/src/include/custommem.h
@@ -167,4 +167,16 @@ int box_munmap(void* addr, size_t length);
 
 void reserveHighMem();
 
+#include <errno.h>
+#include <sys/mman.h>
+// Android mounts shared storage (/storage/emulated) noexec, so the host refuses PROT_EXEC on files mapped from it.
+// Box64 never runs guest pages natively: retry without host exec; the guest's PROT_EXEC stays in Box64's own table.
+static inline int mprotect_guest(void* addr, size_t len, int prot)
+{
+    int ret = mprotect(addr, len, prot);
+    if(ret && (prot&PROT_EXEC) && (errno==EACCES || errno==EPERM))
+        ret = mprotect(addr, len, prot&~PROT_EXEC);
+    return ret;
+}
+
 #endif //__CUSTOM_MEM__H_
