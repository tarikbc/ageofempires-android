+// Patch 0017: entered from FEXCore's guest-signal stubs (SIGILL/SIGTRAP/SIGSEGV breaks of JIT code: ud2, int3, int n,
+// trap-flag steps) with the static registers spilled, on the emulator stack, instead of a hlt/brk host trap. Builds the
+// guest exception as RethrowGuestException does after that trap, without the trap, the signal handler and the first
+// KiUserExceptionDispatcher pass. FEX_EXP_FASTTRAP=0 turns it off. Never returns.
+extern "C" __attribute__((noreturn)) void FastTrapEntry() {
+  uint64_t FPCR, FPSR;
+  __asm volatile("mrs %[fpcr], fpcr" : [fpcr] "=r"(FPCR));
+  __asm volatile("mrs %[fpsr], fpsr" : [fpsr] "=r"(FPSR));
