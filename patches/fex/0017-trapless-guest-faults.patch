+        Info.State == MEM_COMMIT && (Info.Protect & (PAGE_READWRITE | PAGE_EXECUTE_READWRITE)) &&
+        reinterpret_cast<uintptr_t>(Info.BaseAddress) + Info.RegionSize >= Sp + sizeof(KiUserExceptionDispatcherStackLayout)) {
+      auto* Args = reinterpret_cast<KiUserExceptionDispatcherStackLayout*>(Sp);
+      memset(Args, 0, sizeof(*Args));
