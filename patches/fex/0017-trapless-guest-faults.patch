+  auto& Fault = Thread->CurrentFrame->SynchronousFaultData;
+  if (Fault.Signal == FEXCore::Core::FAULT_SIGILL) {
+    __atomic_fetch_add(&FastTrapStats.Ill, 1, __ATOMIC_RELAXED);
