+// Patch 0018 (diagnostic): FEX_EXP_STATSLOG=<folder> writes, once per second, per-thread FEX statistics (CPU time,
+// JIT time and count, SMC faults, exception time) and a histogram of the guest RIPs of the busiest threads to
+// <folder>\fexstats-<exe>-<pid>.txt. FEX_EXP_STATSHZ sets how many times per second the busiest threads are sampled
+// (default 100, 0 = statistics only). A sample suspends the thread and reads its context, the same thing a debugger
+// does; FEX stops a thread in JIT code at the next block start, so a guest RIP is the start of a translated block.
+extern "C" NTSTATUS WINAPI NtResumeThread(HANDLE, PULONG);
+extern "C" NTSTATUS WINAPI NtOpenThread(PHANDLE, ACCESS_MASK, const OBJECT_ATTRIBUTES*, const CLIENT_ID*);
+
+namespace StatsLog {
+constexpr uint32_t MaxSlots = 4096;
+constexpr uint32_t MaxSampledThreads = 4;
+constexpr uint32_t CumulativeEverySeconds = 15;
+
+bool Enabled {};
+uint32_t SampleHz {100};
+FEXCore::SHMStats::ThreadStats* Slots {};
+std::atomic<uint32_t> SlotsUsed {};
+wchar_t OutPathW[600] {};
+HANDLE OutFile {};
+std::mutex OutMutex;
+fextl::unique_ptr<FEXCore::Threads::Thread> LoggerThread;
+std::atomic<bool> Stop {};
+uint64_t StartCycles {};
+
+FEXCore::SHMStats::ThreadStats* AllocateSlot(uint32_t TID) {
+  if (!Slots) {
+    return nullptr;
+  }
+  const uint32_t Idx = SlotsUsed.fetch_add(1, std::memory_order_relaxed);
+  if (Idx >= MaxSlots) {
+    return nullptr;
+  }
+  Slots[Idx].TID.store(TID, std::memory_order_relaxed);
+  return &Slots[Idx];
+}
+
+struct Counters {
+  uint64_t CPU100ns, JITCycles, JITCount, SMC, SigCycles, SIGBUS, CacheMiss, FloatFallback, DCHit, DCMiss;
+};
+
+Counters Read(const FEXCore::SHMStats::ThreadStats* S, uint64_t CPU100ns) {
+  auto Ld = [](const uint64_t& V) {
+    return __atomic_load_n(&V, __ATOMIC_RELAXED);
+  };
+  if (!S) {
+    return {CPU100ns, 0, 0, 0, 0, 0, 0, 0, 0, 0};
+  }
+  return {CPU100ns,
+          Ld(S->AccumulatedJITTime),
+          Ld(S->AccumulatedJITCount),
+          Ld(S->AccumulatedSMCCount),
+          Ld(S->AccumulatedSignalTime),
+          Ld(S->AccumulatedSIGBUSCount),
+          Ld(S->AccumulatedCacheMissCount),
+          Ld(S->AccumulatedFloatFallbackCount),
+          Ld(S->AccumulatedDiskCacheHitCount),
+          Ld(S->AccumulatedDiskCacheMissCount)};
+}
+
+struct ThreadRec {
+  uint32_t TID {};
+  const FEXCore::SHMStats::ThreadStats* Stats {};
+  HANDLE Handle {};
+  bool Alive {};
+  bool Printed {};
+  int NameTries {};
+  fextl::string Name;
+  Counters Last {};
+  Counters Delta {};
+  Counters Total {};
+  uint32_t IntervalSamples {};
+  uint32_t TotalSamples {};
+  fextl::unordered_map<uint64_t, uint32_t> IntervalHist;
+  fextl::unordered_map<uint64_t, uint32_t> TotalHist;
+};
+
+struct ModuleRec {
+  uint64_t Base, End;
+  fextl::string Name;
+};
+
+fextl::vector<ThreadRec> Recs;
+fextl::vector<ModuleRec> Modules;
+
+void Write(const fextl::string& Text) {
+  std::scoped_lock Lock(OutMutex);
+  if (!OutFile || Text.empty()) {
+    return;
+  }
+  IO_STATUS_BLOCK IoSb;
+  NtWriteFile(OutFile, nullptr, nullptr, nullptr, &IoSb, Text.data(), static_cast<ULONG>(Text.size()), nullptr, nullptr);
+}
+
+uint64_t CPUTime(HANDLE H) {
+  KERNEL_USER_TIMES Times {};
+  if (!H || NtQueryInformationThread(H, ThreadTimes, &Times, sizeof(Times), nullptr) < 0) {
+    return 0;
+  }
+  return Times.KernelTime.QuadPart + Times.UserTime.QuadPart;
+}
+
+void QueryName(ThreadRec& R) {
+  if (!R.Name.empty() || R.NameTries > 40 || !R.Handle) {
+    return;
+  }
+  R.NameTries++;
+  struct {
+    UNICODE_STRING Name;
+    WCHAR Buffer[128];
+  } Info {};
+  ULONG Len = 0;
+  if (NtQueryInformationThread(R.Handle, static_cast<THREADINFOCLASS>(38) /* ThreadNameInformation */, &Info, sizeof(Info), &Len) < 0) {
+    return;
+  }
+  const size_t Chars = std::min<size_t>(Info.Name.Length / sizeof(WCHAR), 60);
+  for (size_t i = 0; i < Chars; i++) {
+    const WCHAR C = Info.Name.Buffer[i];
+    R.Name.push_back(C >= 0x20 && C < 0x7f && C != '"' ? static_cast<char>(C) : '?');
+  }
+}
+
+void RefreshThreads() {
+  fextl::vector<std::pair<uint32_t, const FEXCore::SHMStats::ThreadStats*>> Live;
+  {
+    std::scoped_lock Lock(ThreadCreationMutex);
+    Live.reserve(Threads.size());
+    for (auto& [TID, State] : Threads) {
+      Live.emplace_back(TID, State->ThreadStats);
+    }
+  }
+  for (auto& R : Recs) {
+    R.Alive = false;
+  }
+  for (auto& [TID, Stats] : Live) {
+    bool Found = false;
+    for (auto& R : Recs) {
+      if (R.TID == TID && R.Stats == Stats) {
+        R.Alive = true;
+        Found = true;
+        break;
+      }
+    }
+    if (Found) {
+      continue;
+    }
+    ThreadRec R;
+    R.TID = TID;
+    R.Stats = Stats;
+    R.Alive = true;
+    OBJECT_ATTRIBUTES Attr;
+    InitializeObjectAttributes(&Attr, nullptr, 0, nullptr, nullptr);
+    CLIENT_ID Cid {};
+    Cid.UniqueThread = reinterpret_cast<HANDLE>(static_cast<uintptr_t>(TID));
+    if (NtOpenThread(&R.Handle, THREAD_QUERY_INFORMATION | THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT, &Attr, &Cid) < 0) {
+      R.Handle = nullptr;
+    }
+    R.Last = Read(Stats, CPUTime(R.Handle));
+    Recs.push_back(std::move(R));
+  }
+}
+
+const ModuleRec* FindModule(uint64_t Address) {
+  for (const auto& M : Modules) {
+    if (Address >= M.Base && Address < M.End) {
+      return &M;
+    }
+  }
+  MEMORY_BASIC_INFORMATION MBI {};
+  if (NtQueryVirtualMemoryNative(NtCurrentProcess(), reinterpret_cast<void*>(Address), MemoryBasicInformation, &MBI, sizeof(MBI), nullptr) < 0) {
+    return nullptr;
+  }
+  ModuleRec M;
+  M.Base = reinterpret_cast<uint64_t>(MBI.AllocationBase);
+  if (MBI.Type != MEM_IMAGE) {
+    M.Base = reinterpret_cast<uint64_t>(MBI.BaseAddress);
+    M.End = M.Base + MBI.RegionSize;
+    M.Name = "anon";
+    Modules.push_back(std::move(M));
+    return &Modules.back();
+  }
+  // An image can unload while the logger runs. Query its allocation regions instead of dereferencing PE headers.
+  M.End = reinterpret_cast<uint64_t>(MBI.BaseAddress) + MBI.RegionSize;
+  for (int i = 0; i < 4096; i++) {
+    MEMORY_BASIC_INFORMATION Next {};
+    if (NtQueryVirtualMemoryNative(NtCurrentProcess(), reinterpret_cast<void*>(M.End), MemoryBasicInformation, &Next, sizeof(Next), nullptr) < 0 ||
+        Next.Type != MEM_IMAGE || reinterpret_cast<uint64_t>(Next.AllocationBase) != M.Base) {
+      break;
+    }
+    const uint64_t End = reinterpret_cast<uint64_t>(Next.BaseAddress) + Next.RegionSize;
+    if (End <= M.End) {
+      break;
+    }
+    M.End = End;
+  }
+  struct {
+    UNICODE_STRING Name;
+    WCHAR Buffer[520];
+  } Info {};
+  if (NtQueryVirtualMemoryNative(NtCurrentProcess(), reinterpret_cast<void*>(M.Base), MemoryMappedFilenameInformation, &Info, sizeof(Info), nullptr) >= 0 &&
+      Info.Name.Buffer) {
+    const size_t Chars = Info.Name.Length / sizeof(WCHAR);
+    size_t Start = 0;
+    for (size_t i = 0; i < Chars; i++) {
+      if (Info.Name.Buffer[i] == '\\' || Info.Name.Buffer[i] == '/') {
+        Start = i + 1;
+      }
+    }
+    for (size_t i = Start; i < Chars && M.Name.size() < 48; i++) {
+      const WCHAR C = Info.Name.Buffer[i];
+      M.Name.push_back(C >= 0x20 && C < 0x7f ? static_cast<char>(C) : '?');
+    }
+  }
+  if (M.Name.empty()) {
+    M.Name = "image";
+  }
+  Modules.push_back(std::move(M));
+  return &Modules.back();
+}
+
+fextl::string Describe(uint64_t Address) {
+  if (!Address) {
+    return "0";
+  }
+  const auto* M = FindModule(Address);
+  if (!M) {
+    return fextl::fmt::format("{:x}", Address);
+  }
+  if (M->Name == "anon") {
+    return fextl::fmt::format("anon:{:x}", Address);
+  }
+  return fextl::fmt::format("{}+{:x}", M->Name, Address - M->Base);
+}
+
+fextl::string TopList(const fextl::unordered_map<uint64_t, uint32_t>& Hist, uint32_t Total, size_t Count) {
+  fextl::vector<std::pair<uint64_t, uint32_t>> Items(Hist.begin(), Hist.end());
+  std::sort(Items.begin(), Items.end(), [](const auto& A, const auto& B) { return A.second > B.second; });
+  fextl::string Out;
+  for (size_t i = 0; i < Items.size() && i < Count; i++) {
+    Out += fextl::fmt::format(" {}:{}%", Describe(Items[i].first), Total ? (Items[i].second * 100 + Total / 2) / Total : 0);
+  }
+  return Out;
+}
+
+double Seconds() {
+  return static_cast<double>(FEXCore::SHMStats::GetCycleCounter() - StartCycles) /
+         static_cast<double>(FEXCore::Utils::SpinWaitLock::CycleCounterFrequency);
+}
+
+fextl::string UTCClock() {
+  LARGE_INTEGER Now {};
+  NtQuerySystemTime(&Now);
+  const uint64_t Secs = static_cast<uint64_t>(Now.QuadPart / 10000000) % 86400;
+  return fextl::fmt::format("{:02}:{:02}:{:02}", Secs / 3600, (Secs / 60) % 60, Secs % 60);
+}
+
+double CyclesToMs(uint64_t Cycles) {
+  return static_cast<double>(Cycles) * 1000.0 / static_cast<double>(FEXCore::Utils::SpinWaitLock::CycleCounterFrequency);
+}
+
+void SampleOnce() {
+  // The busiest threads of the last interval, by CPU time.
+  ThreadRec* Targets[MaxSampledThreads] {};
+  for (auto& R : Recs) {
+    if (!R.Alive || !R.Handle || R.Delta.CPU100ns < 200000 /* 20 ms per second */) {
+      continue;
+    }
+    for (uint32_t i = 0; i < MaxSampledThreads; i++) {
+      if (!Targets[i] || Targets[i]->Delta.CPU100ns < R.Delta.CPU100ns) {
+        for (uint32_t j = MaxSampledThreads - 1; j > i; j--) {
+          Targets[j] = Targets[j - 1];
+        }
+        Targets[i] = &R;
+        break;
+      }
+    }
+  }
+  for (auto* R : Targets) {
+    if (!R) {
+      continue;
+    }
+    ULONG Prev = 0;
+    if (NtSuspendThread(R->Handle, &Prev) < 0) {
+      continue;
+    }
+    CONTEXT Ctx {};
+    Ctx.ContextFlags = CONTEXT_CONTROL;
+    const NTSTATUS Status = NtGetContextThread(R->Handle, &Ctx);
+    NtResumeThread(R->Handle, nullptr);
+    if (Status < 0) {
+      continue;
+    }
+    R->IntervalHist[Ctx.Rip]++;
+    R->TotalHist[Ctx.Rip]++;
+    R->IntervalSamples++;
+    R->TotalSamples++;
+  }
+}
+
+void Report(double Now, double IntervalSeconds) {
+  fextl::string Out;
+  uint64_t ProcCPU = 0, ProcJIT = 0, ProcSMC = 0, ProcSig = 0, ProcJITCount = 0;
+  for (auto& R : Recs) {
+    ProcCPU += R.Delta.CPU100ns;
+    ProcJIT += R.Delta.JITCycles;
+    ProcJITCount += R.Delta.JITCount;
+    ProcSMC += R.Delta.SMC;
+    ProcSig += R.Delta.SigCycles;
+  }
+  const double Div = IntervalSeconds > 0 ? IntervalSeconds : 1;
+  uint32_t AliveCount = 0;
+  for (auto& R : Recs) {
+    AliveCount += R.Alive;
+  }
+  Out += fextl::fmt::format("T {:.1f} {} threads={} cpu={:.0f}% jit={:.0f}ms/s blocks={:.0f}/s smc={:.0f}/s exc={:.0f}ms/s "
+                            "fasttrap={}/{} fastcontinue={}/{}\n",
+                            Now, UTCClock(), AliveCount, ProcCPU / 100000.0 / Div, CyclesToMs(ProcJIT) / Div, ProcJITCount / Div,
+                            ProcSMC / Div, CyclesToMs(ProcSig) / Div, __atomic_load_n(&Exception::FastTrapStats.Taken, __ATOMIC_RELAXED),
+                            __atomic_load_n(&Exception::FastTrapStats.Fallback, __ATOMIC_RELAXED),
+                            __atomic_load_n(&FastContinueStats.Fast, __ATOMIC_RELAXED), __atomic_load_n(&FastContinueStats.Slow, __ATOMIC_RELAXED));
+  for (auto& R : Recs) {
+    const bool Busy = R.Delta.CPU100ns >= 300000 /* 30 ms per second */ || R.Delta.JITCount >= 50 || R.Delta.SMC >= 10;
+    if (!Busy) {
+      continue;
+    }
+    QueryName(R);
+    Out += fextl::fmt::format("  {:x} \"{}\" cpu={:.0f}% jit={:.0f}ms n={} smc={} exc={:.0f}ms sigbus={} miss={} x87fb={} dc={}/{}", R.TID,
+                              R.Name, R.Delta.CPU100ns / 100000.0 / Div, CyclesToMs(R.Delta.JITCycles) / Div, R.Delta.JITCount,
+                              R.Delta.SMC, CyclesToMs(R.Delta.SigCycles) / Div, R.Delta.SIGBUS, R.Delta.CacheMiss, R.Delta.FloatFallback,
+                              R.Delta.DCHit, R.Delta.DCMiss);
+    if (R.IntervalSamples) {
+      Out += fextl::fmt::format(" s={}", R.IntervalSamples);
+      Out += TopList(R.IntervalHist, R.IntervalSamples, 4);
+    }
+    Out += "\n";
+  }
+  Write(Out);
+}
+
+void Cumulative(const char* Why) {
+  fextl::string Out = fextl::fmt::format("C {:.1f} {} {}\n", Seconds(), UTCClock(), Why);
+  fextl::vector<ThreadRec*> Sorted;
+  for (auto& R : Recs) {
+    if (R.Total.CPU100ns >= 10000000 /* 1 s */ || R.TotalSamples >= 50) {
+      Sorted.push_back(&R);
+    }
+  }
+  std::sort(Sorted.begin(), Sorted.end(), [](const ThreadRec* A, const ThreadRec* B) { return A->Total.CPU100ns > B->Total.CPU100ns; });
+  for (auto* R : Sorted) {
+    QueryName(*R);
+    Out += fextl::fmt::format("  {:x} \"{}\" {} cpu={:.1f}s jit={:.1f}s n={} smc={} exc={:.1f}s s={}", R->TID, R->Name,
+                              R->Alive ? "alive" : "gone", R->Total.CPU100ns / 1.0e7, CyclesToMs(R->Total.JITCycles) / 1000.0,
+                              R->Total.JITCount, R->Total.SMC, CyclesToMs(R->Total.SigCycles) / 1000.0, R->TotalSamples);
+    if (R->TotalSamples) {
+      Out += "\n   ";
+      Out += TopList(R->TotalHist, R->TotalSamples, 30);
+    }
+    Out += "\n";
+  }
+  Write(Out);
+}
+
+void* LoggerMain(void*) {
+  const uint32_t TickMs = SampleHz ? std::max<uint32_t>(1, 1000 / SampleHz) : 250;
+  double LastReport = Seconds();
+  double LastRefresh = -1;
+  uint64_t Reports = 0;
+  while (!Stop.load(std::memory_order_relaxed)) {
+    const double Now = Seconds();
+    if (Now - LastRefresh >= 0.25) {
+      RefreshThreads();
+      LastRefresh = Now;
+    }
+    if (SampleHz) {
+      SampleOnce();
+    }
+    if (Now - LastReport >= 1.0) {
+      for (auto& R : Recs) {
+        const auto Cur = Read(R.Stats, CPUTime(R.Handle));
+        R.Delta = {Cur.CPU100ns - R.Last.CPU100ns,
+                   Cur.JITCycles - R.Last.JITCycles,
+                   Cur.JITCount - R.Last.JITCount,
+                   Cur.SMC - R.Last.SMC,
+                   Cur.SigCycles - R.Last.SigCycles,
+                   Cur.SIGBUS - R.Last.SIGBUS,
+                   Cur.CacheMiss - R.Last.CacheMiss,
+                   Cur.FloatFallback - R.Last.FloatFallback,
+                   Cur.DCHit - R.Last.DCHit,
+                   Cur.DCMiss - R.Last.DCMiss};
+        R.Total = {R.Total.CPU100ns + R.Delta.CPU100ns,
+                   R.Total.JITCycles + R.Delta.JITCycles,
+                   R.Total.JITCount + R.Delta.JITCount,
+                   R.Total.SMC + R.Delta.SMC,
+                   R.Total.SigCycles + R.Delta.SigCycles,
+                   R.Total.SIGBUS + R.Delta.SIGBUS,
+                   R.Total.CacheMiss + R.Delta.CacheMiss,
+                   R.Total.FloatFallback + R.Delta.FloatFallback,
+                   R.Total.DCHit + R.Delta.DCHit,
+                   R.Total.DCMiss + R.Delta.DCMiss};
+        R.Last = Cur;
+      }
+      Report(Now, Now - LastReport);
+      for (auto& R : Recs) {
+        R.IntervalHist.clear();
+        R.IntervalSamples = 0;
+      }
+      LastReport = Now;
+      if (++Reports % CumulativeEverySeconds == 0) {
+        Cumulative("cumulative");
+      }
+      // Forget threads that are gone and were already in a cumulative report.
+      for (size_t i = 0; i < Recs.size();) {
+        if (!Recs[i].Alive && Reports % CumulativeEverySeconds == 0) {
+          if (Recs[i].Handle) {
+            NtClose(Recs[i].Handle);
+          }
+          Recs.erase(Recs.begin() + i);
+        } else {
+          i++;
+        }
+      }
+    }
+    LARGE_INTEGER Delay;
+    Delay.QuadPart = -static_cast<int64_t>(TickMs) * 10000;
+    NtDelayExecution(FALSE, &Delay);
+  }
+  return nullptr;
+}
+
+void Init(const fextl::string& ExeName) {
+  const char* Dir = getenv("FEX_EXP_STATSLOG");
+  if (!Dir || !Dir[0] || (Dir[0] == '0' && !Dir[1])) {
+    return;
+  }
+  if (const char* Hz = getenv("FEX_EXP_STATSHZ"); Hz && Hz[0]) {
+    SampleHz = std::min<uint32_t>(strtoul(Hz, nullptr, 10), 1000);
+  }
+  fextl::string Folder = (Dir[0] == '1' && !Dir[1]) ? fextl::string("D:\\") : fextl::string(Dir);
+  for (auto& C : Folder) {
+    if (C == '/') {
+      C = '\\';
+    }
+  }
+  if (Folder.back() != '\\') {
+    Folder.push_back('\\');
+  }
+  const auto Path = fextl::fmt::format("{}fexstats-{}-{}.txt", Folder, ExeName, GetCurrentProcessId());
+  size_t i = 0;
+  for (; i < Path.size() && i < std::size(OutPathW) - 1; i++) {
+    OutPathW[i] = static_cast<unsigned char>(Path[i]);
+  }
+  OutPathW[i] = 0;
+
+  UNICODE_STRING NtName {};
+  if (!RtlDosPathNameToNtPathName_U(OutPathW, &NtName, nullptr, nullptr)) {
+    return;
+  }
+  OBJECT_ATTRIBUTES Attr;
+  InitializeObjectAttributes(&Attr, &NtName, OBJ_CASE_INSENSITIVE, nullptr, nullptr);
+  IO_STATUS_BLOCK IoSb;
+  const NTSTATUS Status = NtCreateFile(&OutFile, GENERIC_WRITE | SYNCHRONIZE, &Attr, &IoSb, nullptr, FILE_ATTRIBUTE_NORMAL,
+                                       FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OVERWRITE_IF,
+                                       FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE, nullptr, 0);
+  RtlFreeUnicodeString(&NtName);
+  if (Status < 0) {
+    OutFile = nullptr;
+    return;
+  }
+
+  Slots = static_cast<FEXCore::SHMStats::ThreadStats*>(
+    ::VirtualAlloc(nullptr, sizeof(FEXCore::SHMStats::ThreadStats) * MaxSlots, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));
+  if (!Slots) {
+    return;
+  }
+  Enabled = true;
+  StartCycles = FEXCore::SHMStats::GetCycleCounter();
+  Write(fextl::fmt::format("# fexstats 1 exe={} pid={} start={} UTC hz={} counter={}Hz (patch 0018)\n", ExeName, GetCurrentProcessId(),
+                           UTCClock(), SampleHz, FEXCore::Utils::SpinWaitLock::CycleCounterFrequency));
+  LoggerThread = FEXCore::Threads::Thread::Create(LoggerMain, nullptr, {.Internal = true}, "FEX stats");
+}
+
+void Term() {
+  // Other threads may already be gone (and the logger with them, possibly inside Write), so only try the lock.
+  if (!Enabled) {
+    return;
+  }
+  Stop.store(true, std::memory_order_relaxed);
+  if (OutMutex.try_lock()) {
+    const auto Text = fextl::fmt::format("# exit {:.1f} {}\n", Seconds(), UTCClock());
+    IO_STATUS_BLOCK IoSb;
+    NtWriteFile(OutFile, nullptr, nullptr, nullptr, &IoSb, Text.data(), static_cast<ULONG>(Text.size()), nullptr, nullptr);
+    OutMutex.unlock();
+  }
+}
