+constexpr size_t SyscallReturnFixTableOffset = 0xd1;
+uint64_t SyscallReturnFixAddress; // where the replacement lives, 0 if not installed
 
+void InstallSyscallReturnFix() {
+  // mov [rsp+8], r10; pop r10; mov [rsp+8], r10; lea r10, [rip+disp32] -- the start of invoke_arm64ec_syscall
+  static constexpr uint8_t Sig[] = {0x4c, 0x89, 0x54, 0x24, 0x08, 0x41, 0x5a, 0x4c, 0x89, 0x54, 0x24, 0x08, 0x4c, 0x8d, 0x15};
+  const auto* Nt = RtlImageNtHeader(reinterpret_cast<HMODULE>(NtDllBase));
+  const auto* Section = IMAGE_FIRST_SECTION(Nt);
+  uint8_t* Match = nullptr;
+  int Count = 0;
+  for (int i = 0; i < Nt->FileHeader.NumberOfSections; i++, Section++) {
+    if (!(Section->Characteristics & IMAGE_SCN_MEM_EXECUTE)) {
+      continue;
+    }
+    auto* Begin = reinterpret_cast<uint8_t*>(NtDllBase + Section->VirtualAddress);
+    const size_t Size = Section->Misc.VirtualSize;
+    for (size_t j = 0; j + sizeof(Sig) + 4 <= Size; j++) {
+      if (Begin[j] == Sig[0] && memcmp(Begin + j, Sig, sizeof(Sig)) == 0) {
+        Match = Begin + j;
+        Count++;
+      }
+    }
+  }
+  if (Count != 1) {
+    LogMan::Msg::IFmt("Syscall return fix not installed: invoke_arm64ec_syscall signature found {} times", Count);
+    return;
+  }
+  int32_t Disp;
+  memcpy(&Disp, Match + sizeof(Sig), sizeof(Disp));
+  const uint64_t Table = reinterpret_cast<uint64_t>(Match) + 12 + 7 + Disp;
+
+  void* Code = nullptr;
+  SIZE_T CodeSize = FEXCore::Utils::FEX_PAGE_SIZE;
+  if (NtAllocateVirtualMemoryNative(NtCurrentProcess(), &Code, 0, &CodeSize, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE)) {
+    return;
+  }
+  memcpy(Code, SyscallReturnFixCode, sizeof(SyscallReturnFixCode));
+  memcpy(static_cast<uint8_t*>(Code) + SyscallReturnFixTableOffset, &Table, sizeof(Table));
+  ULONG OldProt;
+  void* ProtAddress = Code;
+  SIZE_T ProtSize = CodeSize;
+  NtProtectVirtualMemoryNative(NtCurrentProcess(), &ProtAddress, &ProtSize, PAGE_EXECUTE_READ, &OldProt);
+  InvalidationTracker->HandleMemoryProtectionNotification(reinterpret_cast<uint64_t>(Code), CodeSize, PAGE_EXECUTE_READ);
+
+  uint8_t Jump[14] = {0xff, 0x25, 0, 0, 0, 0}; // jmp [rip+0]; .quad Code
+  memcpy(Jump + 6, &Code, sizeof(Code));
+  ProtAddress = Match;
+  ProtSize = sizeof(Jump);
+  NtProtectVirtualMemoryNative(NtCurrentProcess(), &ProtAddress, &ProtSize, PAGE_EXECUTE_READWRITE, &OldProt);
+  memcpy(Match, Jump, sizeof(Jump));
+  NtProtectVirtualMemoryNative(NtCurrentProcess(), &ProtAddress, &ProtSize, OldProt, &OldProt);
+  InvalidationTracker->InvalidateAlignedInterval(reinterpret_cast<uint64_t>(Match), sizeof(Jump), false);
+  SyscallReturnFixAddress = reinterpret_cast<uint64_t>(Code);
+  LogMan::Msg::IFmt("Syscall return fix installed: helper {:X} -> {:X}, table {:X}", reinterpret_cast<uint64_t>(Match),
+                    SyscallReturnFixAddress, Table);
+}
