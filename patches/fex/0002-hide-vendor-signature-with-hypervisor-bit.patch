--- a/FEXCore/Source/Interface/Core/CPUID.cpp
+++ b/FEXCore/Source/Interface/Core/CPUID.cpp
@@ -978,6 +978,15 @@ FEXCore::CPUID::FunctionResults CPUIDEmu::Function_4000_0000h(uint32_t Leaf) con
   // CPUID documentation information:
   // 4000_0000h - 4FFF_FFFFh - No existing or future CPU will return information in this range
   // Reserved entirely for VMs to do whatever they want.
+
+  // If the hypervisor-present bit is hidden, the guest has already been told there is no
+  // hypervisor (see Function_1h). Handing out a vendor signature anyway is inconsistent --
+  // software that asks this leaf is asking precisely because bit 31 said a hypervisor is
+  // there -- and the signature names the emulator to anything that looks.
+  if (HideHypervisorBit()) {
+    return Res;
+  }
+
   Res.eax = 0x40000001;
 
   // EBX, EDX, ECX become the hypervisor ID signature
