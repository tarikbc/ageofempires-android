+// Patch 0010: counters for the fast continue path, at file scope so a probe can find them by the marker.
+struct FastContinueStatsType {
+  uint64_t Marker;
+  uint64_t Fast;
+  uint64_t Slow;
+};
+FastContinueStatsType FastContinueStats = {0x31544e4f43545346ULL, 0, 0}; // "FSTCONT1"
+uintptr_t KiUserEmulationDispatcherNative;
+
+// Patch 0010: NtContinue to x64 code without the syscall. Wine's unix NtContinue (signal_set_full_context) sets the
+// context, then for a non-EC target calls NtGetContextThread(GetCurrentThread()), copies that context below the
+// target stack and enters KiUserEmulationDispatcher. In GameNative's Proton 11 ARM64EC, NtGetContextThread starts with
+// NtQueryInformationThread(ThreadBasicInformation) to find out whether the handle is the current thread, which is a
+// wineserver round trip. So every exception the guest handles and resumes waits for wineserver. This does the same
+// re-entry directly: KiUserEmulationDispatcher converts the context into the CPU area and BeginSimulation resets sp to
+// the emulator stack base, so a copy near that base is consumed before it can be overwritten. Not done for alertable
+// continues (APC delivery), partial contexts, or EC targets. A suspend request that is pending is then served at the
+// thread's next syscall instead of here.
+extern "C" NTSTATUS NtContinueHooked(ARM64_NT_CONTEXT* Context, BOOLEAN Alertable) {
+  constexpr ULONG FullFlags = 0x7; // CONTEXT_CONTROL | CONTEXT_INTEGER | CONTEXT_FLOATING_POINT (ARM64)
+  if (!Alertable && Context && (Context->ContextFlags & FullFlags) == FullFlags && KiUserEmulationDispatcherNative &&
+      !RtlIsEcCode(Context->Pc)) {
+    const auto CPUArea = GetCPUArea();
+    // Context lives on the thread stack (the NtContinue wrapper's frame), never on the emulator stack.
+    const uintptr_t Dest = (CPUArea.EmulatorStackBase() - 0x400 - sizeof(ARM64_NT_CONTEXT)) & ~uintptr_t {15};
+    memcpy(reinterpret_cast<void*>(Dest), Context, sizeof(ARM64_NT_CONTEXT));
+    __atomic_fetch_add(&FastContinueStats.Fast, 1, __ATOMIC_RELAXED);
+    JumpSetStack(KiUserEmulationDispatcherNative, Dest);
+  }
+  __atomic_fetch_add(&FastContinueStats.Slow, 1, __ATOMIC_RELAXED);
+  return NtContinueNative(Context, Alertable);
+}
