+namespace {
+struct WorkingSetExEntry {
+  void* VirtualAddress;
+  ULONG_PTR Attributes; // bit 0 Valid, bits 4-14 Win32Protection
+};
+
+void FixupBasicInformation(MEMORY_BASIC_INFORMATION* Info) {
+  if (Info->State != MEM_COMMIT) {
+    return;
+  }
+
+  const auto Base = reinterpret_cast<uint64_t>(Info->BaseAddress);
+  const ULONG Visible = InvalidationTracker->GuestVisibleProtection(Base, Info->Protect);
+  bool AnyFixed = Visible != Info->Protect;
+  Info->Protect = Visible;
+
+  // A trapped page splits the guest's region in two. Merge following pages that look the same to the guest, so the
+  // region boundaries match what the guest would see without the trap.
+  uint64_t Next = Base + Info->RegionSize;
+  for (int i = 0; i < 256; i++) {
+    if (!AnyFixed && !InvalidationTracker->IsTrapped(Next)) {
+      break;
+    }
+    MEMORY_BASIC_INFORMATION NextInfo;
+    if (NtQueryVirtualMemoryNative(NtCurrentProcess(), reinterpret_cast<void*>(Next), MemoryBasicInformation, &NextInfo, sizeof(NextInfo), nullptr) ||
+        NextInfo.AllocationBase != Info->AllocationBase || NextInfo.State != Info->State || NextInfo.Type != Info->Type ||
+        NextInfo.AllocationProtect != Info->AllocationProtect) {
+      break;
+    }
+    const ULONG NextVisible = InvalidationTracker->GuestVisibleProtection(Next, NextInfo.Protect);
+    if (NextVisible != Visible) {
+      break;
+    }
+    AnyFixed |= NextVisible != NextInfo.Protect;
+    Info->RegionSize += NextInfo.RegionSize;
+    Next += NextInfo.RegionSize;
+  }
+}
+} // namespace
+
+extern "C" NTSTATUS NtQueryVirtualMemoryHooked(HANDLE Process, LPCVOID Address, MEMORY_INFORMATION_CLASS Class, PVOID Buffer,
+                                               SIZE_T Length, SIZE_T* ResultLength) {
+  const NTSTATUS Status = NtQueryVirtualMemoryNative(Process, Address, Class, Buffer, Length, ResultLength);
+  if (Status || Process != NtCurrentProcess() || !InvalidationTracker) {
+    return Status;
+  }
+
+  if ((Class == MemoryBasicInformation || Class == MemoryBasicInformationCapped) && Length >= sizeof(MEMORY_BASIC_INFORMATION)) {
+    FixupBasicInformation(static_cast<MEMORY_BASIC_INFORMATION*>(Buffer));
+  } else if (Class == MemoryWorkingSetExInformation) {
+    auto* Entries = static_cast<WorkingSetExEntry*>(Buffer);
+    for (SIZE_T i = 0; i < Length / sizeof(WorkingSetExEntry); i++) {
+      if (!(Entries[i].Attributes & 1)) {
+        continue;
+      }
+      const ULONG Prot = (Entries[i].Attributes >> 4) & 0x7ff;
+      const ULONG Visible = InvalidationTracker->GuestVisibleProtection(reinterpret_cast<uint64_t>(Entries[i].VirtualAddress), Prot);
+      Entries[i].Attributes = (Entries[i].Attributes & ~(ULONG_PTR(0x7ff) << 4)) | (ULONG_PTR(Visible & 0x7ff) << 4);
+    }
+  }
+  return Status;
+}
+
+extern "C" NTSTATUS NtProtectVirtualMemoryHooked(HANDLE Process, PVOID* AddressPtr, SIZE_T* SizePtr, ULONG NewProt, ULONG* OldProt) {
+  const NTSTATUS Status = NtProtectVirtualMemoryNative(Process, AddressPtr, SizePtr, NewProt, OldProt);
+  if (!Status && OldProt && Process == NtCurrentProcess() && InvalidationTracker) {
+    *OldProt = InvalidationTracker->GuestVisibleProtection(reinterpret_cast<uint64_t>(*AddressPtr), *OldProt);
+  }
+  return Status;
+}
