+void InvalidationTracker::RecordTrapped(uint64_t Address, uint64_t Size) {
+  std::scoped_lock TLock(TrappedLock);
+  TrappedIntervals.Insert({Address, Address + Size});
+}
+
+void InvalidationTracker::ForgetTrapped(uint64_t Address, uint64_t Size) {
+  std::scoped_lock TLock(TrappedLock);
+  TrappedIntervals.Remove({Address, Address + Size});
+}
+
+bool InvalidationTracker::IsTrapped(uint64_t Address) {
+  std::unique_lock TLock(TrappedLock, std::try_to_lock);
+  return TLock.owns_lock() && TrappedIntervals.Query(Address).Enclosed;
+}
+
+ULONG InvalidationTracker::GuestVisibleProtection(uint64_t Address, ULONG Prot) {
+  if (!IsTrapped(Address)) {
+    return Prot;
+  }
+
+  std::shared_lock Lock(IntervalsLock, std::try_to_lock);
+  if (!Lock.owns_lock() || (Prot & 0xff) != GetTrapProt(Address)) {
+    return Prot;
+  }
+  return (Prot & ~0xffUL) | GetUntrapProt(Address);
+}
