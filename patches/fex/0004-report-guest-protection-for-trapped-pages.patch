+
+  // Installed into ntdll's __wine_syscall_dispatcher pointer. Wine's syscall stubs enter here with the syscall number
+  // in x8, the stub's caller's return address in x9 and x30 pointing at the stub's own ret. Every syscall but the two
+  // below goes straight on to Wine's dispatcher with all registers untouched. Those two branch to a C++ wrapper with
+  // x30 set to the original caller, as if the caller had called the wrapper, and the wrapper issues the real syscall
+  // through the saved dispatcher (the *Native wrappers above).
+.global SyscallDispatcherHook
+SyscallDispatcherHook:
+  adrp x16, HookQueryVirtualMemoryId
+  ldr x16, [x16, #:lo12:HookQueryVirtualMemoryId]
+  cmp x8, x16
+  b.eq 1f
+  adrp x16, HookProtectVirtualMemoryId
+  ldr x16, [x16, #:lo12:HookProtectVirtualMemoryId]
+  cmp x8, x16
+  b.eq 2f
+  adrp x16, WineSyscallDispatcher
+  ldr x16, [x16, #:lo12:WineSyscallDispatcher]
+  br x16
+1:
+  mov x30, x9
+  b "#NtQueryVirtualMemoryHooked"
+2:
+  mov x30, x9
+  b "#NtProtectVirtualMemoryHooked"
 
