+bool ContextImpl::IsVolatileCode(uint64_t Address) const {
+  const uint32_t N = NumVolatileCodeRegions.load(std::memory_order_acquire);
+  for (uint32_t i = 0; i < N; i++) {
+    if (Address >= VolatileCodeRegions[i].Base && Address < VolatileCodeRegions[i].End) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ContextImpl::AddVolatileCodeRegion(uint64_t Base, uint64_t Size) {
+  std::scoped_lock lk(VolatileCodeMutex);
+  if (IsVolatileCode(Base)) {
+    return;
+  }
+  const uint32_t N = NumVolatileCodeRegions.load(std::memory_order_relaxed);
+  if (N >= 4) {
+    return;
+  }
+  VolatileCodeRegions[N] = {Base, Base + Size};
+  VolatileCodeStats.RegionBase[N] = Base;
+  VolatileCodeStats.RegionSize[N] = Size;
+  VolatileCodeStats.Regions = N + 1;
+  NumVolatileCodeRegions.store(N + 1, std::memory_order_release);
+}
+
+static uint64_t VolatileKeyHash(const uint8_t* Bytes, uint8_t Len, uint64_t Target) {
+  uint64_t H = 0xcbf29ce484222325ULL ^ Target;
+  for (uint8_t i = 0; i < Len; i++) {
+    H = (H ^ Bytes[i]) * 0x100000001b3ULL;
+  }
+  return H ^ (H >> 29);
+}
+
+// A block in a volatile region. It is never added to the lookup caches, so this runs on every visit. Blocks of the
+// form [one position-independent instruction][jmp rel8/rel32 out of the region] produce the same host code wherever they
+// are (the JIT resolves the exit to an absolute target), so they are cached by content for the thread's current code
+// buffer. Anything else is compiled for this one visit.
+uintptr_t ContextImpl::CompileVolatileBlock(FEXCore::Core::InternalThreadState* Thread, uint64_t GuestRIP) {
+  Thread->VolatileEntryRIP = GuestRIP;
+
+  Thread->FrontendDecoder->SetupDecodeInstructionsAtEntry(Thread, GuestRIP, 2);
+  Thread->FrontendDecoder->DecodeLoop(reinterpret_cast<const uint8_t*>(GuestRIP));
+  const auto* BlockInfo = Thread->FrontendDecoder->GetDecodedBlockInfo();
+
+  bool Eligible = false;
+  uint8_t Len = 0;
+  uint8_t Bytes[15] {};
+  uint64_t Target = 0;
+  if (BlockInfo->Blocks.size() == 1) {
+    const auto& Block = BlockInfo->Blocks[0];
+    if (Block.Entry == GuestRIP && Block.BlockStatus == FEXCore::Frontend::Decoder::DecodedBlockStatus::SUCCESS && Block.NumInstructions == 2) {
+      const auto& I0 = Block.DecodedInstructions[0];
+      const auto& I1 = Block.DecodedInstructions[1];
+      auto PositionDependent = [](const FEXCore::X86Tables::DecodedOperand& Op) {
+        return Op.IsRIPRelative() || Op.IsRIPRelativeRelocation() || Op.IsLiteralRelocation() || Op.IsGPRIndirectRelocation() ||
+               Op.IsSIBRelocation() || Op.IsLiteralPatchable();
+      };
+      const auto* P0 = reinterpret_cast<const uint8_t*>(GuestRIP);
+      if (I0.TableInfo && I1.TableInfo && I0.PC == GuestRIP && I0.InstSize > 0 && I0.InstSize <= 15 &&
+          !(I0.TableInfo->Flags & (FEXCore::X86Tables::InstFlags::FLAGS_SETS_RIP | FEXCore::X86Tables::InstFlags::FLAGS_BLOCK_END)) &&
+          !PositionDependent(I0.Dest) && !PositionDependent(I0.Src[0]) && !PositionDependent(I0.Src[1]) &&
+          !PositionDependent(I0.Src[2]) && !(I0.OPRaw >= 0xD8 && I0.OPRaw <= 0xDF)) {
+        const auto* P1 = P0 + I0.InstSize;
+        int64_t Disp = 0;
+        bool IsJmp = false;
+        if (I1.InstSize == 5 && P1[0] == 0xE9) {
+          int32_t D;
+          memcpy(&D, P1 + 1, sizeof(D));
+          Disp = D;
+          IsJmp = true;
+        } else if (I1.InstSize == 2 && P1[0] == 0xEB) {
+          Disp = static_cast<int8_t>(P1[1]);
+          IsJmp = true;
+        }
+        if (IsJmp) {
+          Target = GuestRIP + I0.InstSize + I1.InstSize + Disp;
+          Len = I0.InstSize;
+          memcpy(Bytes, P0, Len);
+          Eligible = !IsVolatileCode(Target);
+        }
+      }
+    }
+  }
+
+  if (Eligible) {
+    const void* Buffer = Thread->CPUBackend->GetCurrentCodeBufferPtr();
+    const uint64_t Generation = Thread->CPUBackend->GetCurrentCodeBufferGeneration();
+    uintptr_t Host = 0;
+    {
+      std::scoped_lock lk(VolatileCacheMutex);
+      if (!VolatileCache.empty()) {
+        const uint64_t H = VolatileKeyHash(Bytes, Len, Target);
+        for (size_t i = 0; i < 8; i++) {
+          const auto& E = VolatileCache[(H + i) & (VolatileCache.size() - 1)];
+          if (E.Host && E.Buffer == Buffer && E.Generation == Generation && E.Target == Target && E.Len == Len &&
+              !memcmp(E.Bytes, Bytes, Len)) {
+            Host = E.Host;
+            break;
+          }
+        }
+      }
+    }
+    if (Host) {
+      __atomic_fetch_add(&VolatileCodeStats.Hits, 1, __ATOMIC_RELAXED);
+      Thread->FrontendDecoder->DelayedDisownBuffer();
+      Thread->FrontendDecoder->ValidateDisownedOrFree();
+      Thread->OpDispatcher->ValidateDisownedOrFree();
+      return Host;
+    }
+  }
+
+  // Compile for this visit only: no lookup cache entry, no executable-range tracking (so no write trap).
+  Thread->FrontendDecoder->SetupDecodeInstructionsAtEntry(Thread, GuestRIP, 2);
+  FEXCORE_PROFILE_INSTANT_INCREMENT(Thread, AccumulatedJITCount, 1);
+  auto [CompiledCode, DebugData, StartAddr, Length, NeedsAddGuestCodeRanges] = CompileCode(Thread, GuestRIP, 2);
+  auto CodePtr = CompiledCode.EntryPoints[GuestRIP];
+  if (CodePtr == nullptr) {
+    return 0;
+  } else if (!DebugData) {
+    return reinterpret_cast<uintptr_t>(CodePtr);
+  }
+  if (!CodeCache.IsGeneratingCache) {
+    Thread->CPUBackend->ClearRelocations();
+  }
+  Thread->FrontendDecoder->ValidateDisownedOrFree();
+  Thread->OpDispatcher->ValidateDisownedOrFree();
+
+  if (Eligible) {
+    const void* Buffer = Thread->CPUBackend->GetCurrentCodeBufferPtr();
+    const uint64_t Generation = Thread->CPUBackend->GetCurrentCodeBufferGeneration();
+    std::scoped_lock lk(VolatileCacheMutex);
+    if (VolatileCache.empty()) {
+      VolatileCache.resize(8192);
+    }
+    const uint64_t H = VolatileKeyHash(Bytes, Len, Target);
+    size_t Slot = H & (VolatileCache.size() - 1);
+    for (size_t i = 0; i < 8; i++) {
+      const size_t Idx = (H + i) & (VolatileCache.size() - 1);
+      const auto& E = VolatileCache[Idx];
+      if (!E.Host || E.Buffer != Buffer || E.Generation != Generation ||
+          (E.Target == Target && E.Len == Len && !memcmp(E.Bytes, Bytes, Len))) {
+        Slot = Idx;
+        break;
+      }
+    }
+    auto& E = VolatileCache[Slot];
+    E.Buffer = Buffer;
+    E.Generation = Generation;
+    E.Target = Target;
+    E.Host = reinterpret_cast<uintptr_t>(CodePtr);
+    E.Len = Len;
+    memcpy(E.Bytes, Bytes, Len);
+    __atomic_fetch_add(&VolatileCodeStats.Misses, 1, __ATOMIC_RELAXED);
+  } else {
+    __atomic_fetch_add(&VolatileCodeStats.Ineligible, 1, __ATOMIC_RELAXED);
+  }
+  return reinterpret_cast<uintptr_t>(CodePtr);
+}
