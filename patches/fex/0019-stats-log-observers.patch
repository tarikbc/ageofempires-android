+size_t HashSlot(uint64_t Key, size_t Size) {
+  return static_cast<size_t>((Key * 0x9E3779B97F4A7C15ULL) >> 40) & (Size - 1);
+}
+
+void OnSMCFault(FEXCore::Core::InternalThreadState* Thread, uint64_t HostPc, uint64_t FaultAddress) {
+  const uint64_t Page = FaultAddress & ~uint64_t {0xfff};
+  const bool FromJIT = CTX->IsAddressInCodeBuffer(Thread, HostPc);
+  const uint64_t Writer = CTX->RestoreRIPFromHostPC(Thread, HostPc);
+  std::scoped_lock Lock(SMCMutex);
+  Faults++;
+  const size_t H = HashSlot(Page, PageTableSize);
+  for (size_t i = 0; i < 32; i++) {
+    auto& E = PageTable[(H + i) & (PageTableSize - 1)];
+    if (E.Page == Page || E.Page == 0) {
+      E.Page = Page;
+      E.Count++;
+      E.FromJIT += FromJIT;
+      E.WriterRIP = Writer;
+      E.HostPc = HostPc;
+      return;
+    }
+  }
+  PageOverflow++;
+}
+
+void AddRip(RipStat* Table, uint64_t Rip, uint64_t& Overflow) {
+  const size_t H = HashSlot(Rip, RipTableSize);
+  for (size_t i = 0; i < 32; i++) {
+    auto& E = Table[(H + i) & (RipTableSize - 1)];
+    if (E.Rip == Rip || E.Rip == 0) {
+      E.Rip = Rip;
+      E.Count++;
+      return;
+    }
+  }
+  Overflow++;
+}
+
+void OnVolatileCompile(uint64_t Rip) {
+  std::scoped_lock Lock(RipMutex);
+  VolCompiles++;
+  AddRip(VolTable, Rip, VolOverflow);
+}
+
+struct ExceptionStat {
+  uint64_t Rip;
+  uint64_t Count;
+  uint32_t Code;
+};
+ExceptionStat ExcTable[RipTableSize];
+uint64_t ExcCount {}, ExcSlow {}, ExcOverflow {};
+std::mutex ExcMutex;
+
+void OnGuestException(uint32_t Code, uint64_t Rip, bool Fast) {
+  std::scoped_lock Lock(ExcMutex);
+  ExcCount++;
+  ExcSlow += !Fast;
+  const size_t H = HashSlot(Rip ^ (static_cast<uint64_t>(Code) << 32), RipTableSize);
+  for (size_t i = 0; i < 32; i++) {
+    auto& E = ExcTable[(H + i) & (RipTableSize - 1)];
+    if (!E.Count || (E.Rip == Rip && E.Code == Code)) {
+      E.Rip = Rip;
+      E.Code = Code;
+      E.Count++;
+      return;
+    }
+  }
+  ExcOverflow++;
+}
+
+void OnDiskCacheHit(uint64_t Rip) {
+  std::scoped_lock Lock(RipMutex);
+  DCHits++;
+  AddRip(DCTable, Rip, DCOverflow);
+}
