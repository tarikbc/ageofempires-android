+  // The guest's view: patch 0004 reports the protection the guest set, not the trap.
+  const ULONG Visible = InvalidationTracker ? InvalidationTracker->GuestVisibleProtection(Page, MBI.Protect) : MBI.Protect;
+  return fextl::fmt::format("{}{}{}", MBI.Type == MEM_IMAGE ? "img " : MBI.Type == MEM_MAPPED ? "map " : "prv ", ProtName(Visible),
+                            CTX->IsVolatileCode(Page) ? " volatile" : "");
+}
