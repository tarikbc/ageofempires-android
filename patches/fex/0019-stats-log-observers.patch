+fextl::string PageInfo(uint64_t Page) {
+  MEMORY_BASIC_INFORMATION MBI {};
+  if (NtQueryVirtualMemoryNative(NtCurrentProcess(), reinterpret_cast<void*>(Page), MemoryBasicInformation, &MBI, sizeof(MBI), nullptr) < 0) {
+    return "?";
