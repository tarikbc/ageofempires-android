+// Experiment: reuse of translations when the same guest bytes come back (see TryReuseBlock).
+extern "C" {
+struct CodeReuseStatsT {
+  uint64_t Marker; // "REUSE001"
+  uint64_t Stored;
+  uint64_t Lookups;
+  uint64_t Hits;
+  uint64_t Mismatch;
